{
	# FrankenPHP's admin API and automatic HTTPS are not wanted here: the platform in front (Vercel, a load
	# balancer) terminates TLS, and this server only speaks plain HTTP on $PORT.
	admin off
	auto_https off
}

:{$PORT:8080} {
	root * /app/public
	encode zstd gzip

	# Headers every response carries. (A Content-Security-Policy follows with the app's security pass.)
	header {
		-X-Powered-By
		-Server
		X-Content-Type-Options "nosniff"
		X-Frame-Options "DENY"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
		Cross-Origin-Opener-Policy "same-origin"
	}

	# Static files (built assets, fonts, icons) are served directly, with a long cache for the hashed ones.
	@hashed path /build/assets/*
	header @hashed Cache-Control "public, max-age=31536000, immutable"

	# Never serve dot-files or anything outside public/.
	@hidden {
		path */.*
		not path /.well-known/*
	}
	respond @hidden 404

	php_server {
		try_files {path} index.php
	}
}
