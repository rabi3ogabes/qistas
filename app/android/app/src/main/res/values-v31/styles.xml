<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- While the app starts: the Qistas canvas and mark (see drawable/launch_background.xml) and, from Android 12, the system splash in the same colours. -->
    <style name="LaunchTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
        <item name="android:windowSplashScreenBackground">@color/launch_canvas</item>
        <item name="android:windowSplashScreenAnimatedIcon">@drawable/splash_mark</item>
    </style>
    <!-- Behind the app while it runs: the same canvas, so a keyboard or a rotation never shows a white edge. -->
    <style name="NormalTheme" parent="@android:style/Theme.Light.NoTitleBar">
        <item name="android:windowBackground">@color/launch_canvas</item>
    </style>
</resources>
