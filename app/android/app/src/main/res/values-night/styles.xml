<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- While the app starts: the Qistas canvas and mark (see drawable/launch_background.xml). -->
    <style name="LaunchTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@drawable/launch_background</item>
    </style>
    <!-- Behind the app while it runs: the same canvas, so a keyboard or a rotation never shows a white edge. -->
    <style name="NormalTheme" parent="@android:style/Theme.Black.NoTitleBar">
        <item name="android:windowBackground">@color/launch_canvas</item>
    </style>
</resources>
