<?xml version="1.0" encoding="utf-8"?>
<!-- The card behind the home-screen widget: the app's canvas colour (ivory, navy in dark mode), softly rounded, with a
     hairline in the app's own line colour. -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">
    <solid android:color="@color/glance_surface" />
    <corners android:radius="24dp" />
    <stroke
        android:width="1dp"
        android:color="@color/glance_line" />
</shape>
