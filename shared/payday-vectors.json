{
  "_note": "HAND-COMPUTED from the calendar, not generated. The web's resources/js/pay-day.js (run through Node by web/tests/Feature/App/PayPatternWebTest.php) and the app's Dart nextOccurrence must reproduce every case: expected is '' where there is no suggestion. Each case's edge says what it pins.",
  "rule": [
    "nextOccurrence(typed, today, day, endOfMonth) gives the first-due date a customer's usual payday suggests, as 'YYYY-MM-DD', or '' for no suggestion.",
    "typed is what the first-due field holds now (null or '' when empty). today is the workspace's today as the server sent it. day is the customer's usual day, an integer. endOfMonth is true when they pay at the end of the month, whatever its length (the server sends day 28 with it).",
    "1. day must be an integer from 1 to 28, otherwise the answer is ''. This holds at the end of the month too.",
    "2. X is typed when it is exactly YYYY-MM-DD (four, two and two ASCII digits, nothing before or after) and names a real calendar day in the years 0001 to 9999. Otherwise X is today when that is one. When neither is, the answer is ''.",
    "3. If endOfMonth, the answer is the last day of X's month (28, 29, 30 or 31; February has 29 days in a year divisible by 4, except in a year divisible by 100 unless it is also divisible by 400).",
    "4. Otherwise it is day `day` of X's month, unless that is before X; then it is day `day` of the next month (December goes into January of the next year). X on `day` itself answers X.",
    "5. A result in a year past 9999 is ''.",
    "Do the arithmetic on whole years, months and days. Never make a date-time object from the typed text: a date string read as UTC and shown in a local zone is a day out in half the world.",
    "In a case's edge note, X is the date the rule starts from and D is day."
  ],
  "cases": [
    {"typed": "2026-11-07", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-11-27", "edge": "typed before D"},
    {"typed": "2026-11-26", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-11-27", "edge": "the day before D"},
    {"typed": "2026-11-27", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-11-27", "edge": "typed on D"},
    {"typed": "2026-11-28", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-12-27", "edge": "the day after D"},
    {"typed": "2026-11-30", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-12-27", "edge": "the end of the month, after D"},
    {"typed": "2026-03-01", "today": "2026-10-21", "day": 1, "endOfMonth": false, "expected": "2026-03-01", "edge": "D is the 1st, typed on it"},
    {"typed": "2026-03-02", "today": "2026-10-21", "day": 1, "endOfMonth": false, "expected": "2026-04-01", "edge": "D is the 1st, typed after it"},
    {"typed": "2026-01-31", "today": "2026-10-21", "day": 15, "endOfMonth": false, "expected": "2026-02-15", "edge": "from the 31st into a short month"},
    {"typed": "2026-11-01", "today": "2026-10-21", "day": 28, "endOfMonth": false, "expected": "2026-11-28", "edge": "D is the 28th, not flagged as the end of the month"},
    {"typed": "2026-02-28", "today": "2026-10-21", "day": 28, "endOfMonth": false, "expected": "2026-02-28", "edge": "D is the 28th, typed on it in February"},
    {"typed": "2026-03-29", "today": "2026-10-21", "day": 28, "endOfMonth": false, "expected": "2026-04-28", "edge": "D is the 28th, typed the 29th"},
    {"typed": "2026-12-27", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-12-27", "edge": "December, on D"},
    {"typed": "2026-12-28", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2027-01-27", "edge": "December rolls over"},
    {"typed": "2026-12-31", "today": "2026-10-21", "day": 1, "endOfMonth": false, "expected": "2027-01-01", "edge": "New Year's Eve, D the 1st"},
    {"typed": "2028-02-29", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2028-03-27", "edge": "the leap day, after D"},
    {"typed": "2028-02-01", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2028-02-27", "edge": "leap February, before D"},
    {"typed": "2026-11-03", "today": "2026-10-21", "day": 28, "endOfMonth": true, "expected": "2026-11-30", "edge": "a 30-day month"},
    {"typed": "2026-10-03", "today": "2026-10-21", "day": 28, "endOfMonth": true, "expected": "2026-10-31", "edge": "a 31-day month"},
    {"typed": "2026-11-30", "today": "2026-10-21", "day": 28, "endOfMonth": true, "expected": "2026-11-30", "edge": "already on the last day of a 30-day month"},
    {"typed": "2026-10-31", "today": "2026-10-21", "day": 28, "endOfMonth": true, "expected": "2026-10-31", "edge": "already on the last day of a 31-day month"},
    {"typed": "2026-12-15", "today": "2026-10-21", "day": 28, "endOfMonth": true, "expected": "2026-12-31", "edge": "December"},
    {"typed": "2026-01-31", "today": "2026-10-21", "day": 28, "endOfMonth": true, "expected": "2026-01-31", "edge": "January"},
    {"typed": "2027-02-15", "today": "2026-10-21", "day": 28, "endOfMonth": true, "expected": "2027-02-28", "edge": "February in an ordinary year"},
    {"typed": "2028-02-15", "today": "2026-10-21", "day": 28, "endOfMonth": true, "expected": "2028-02-29", "edge": "February in a leap year"},
    {"typed": "2028-02-29", "today": "2026-10-21", "day": 28, "endOfMonth": true, "expected": "2028-02-29", "edge": "the leap day itself"},
    {"typed": "2100-02-10", "today": "2026-10-21", "day": 28, "endOfMonth": true, "expected": "2100-02-28", "edge": "2100 is not a leap year"},
    {"typed": "2000-02-10", "today": "2026-10-21", "day": 28, "endOfMonth": true, "expected": "2000-02-29", "edge": "2000 is a leap year"},
    {"typed": "2026-11-03", "today": "2026-10-21", "day": 15, "endOfMonth": true, "expected": "2026-11-30", "edge": "the end of the month wins over the day"},
    {"typed": "", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-10-27", "edge": "empty, today before D"},
    {"typed": "", "today": "2026-10-27", "day": 27, "endOfMonth": false, "expected": "2026-10-27", "edge": "empty, today on D"},
    {"typed": "", "today": "2026-10-28", "day": 27, "endOfMonth": false, "expected": "2026-11-27", "edge": "empty, today after D"},
    {"typed": "", "today": "2026-12-28", "day": 5, "endOfMonth": false, "expected": "2027-01-05", "edge": "empty, in December"},
    {"typed": "", "today": "2026-10-21", "day": 28, "endOfMonth": true, "expected": "2026-10-31", "edge": "empty, end of the month"},
    {"typed": null, "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-10-27", "edge": "null"},
    {"typed": "2026-02-30", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-10-27", "edge": "there is no 30 February"},
    {"typed": "2026-02-29", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-10-27", "edge": "2026 is not a leap year"},
    {"typed": "2026-13-01", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-10-27", "edge": "there is no month 13"},
    {"typed": "2026-00-10", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-10-27", "edge": "there is no month 0"},
    {"typed": "2026-04-31", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-10-27", "edge": "April has 30 days"},
    {"typed": "0000-01-01", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-10-27", "edge": "there is no year 0"},
    {"typed": "garbage", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-10-27", "edge": "not a date"},
    {"typed": "2026-1-5", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-10-27", "edge": "not written with two digits"},
    {"typed": "26-11-07", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-10-27", "edge": "a two-digit year"},
    {"typed": "2026/11/07", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-10-27", "edge": "slashes"},
    {"typed": " 2026-11-07", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-10-27", "edge": "a leading space"},
    {"typed": "2026-11-07\n", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-10-27", "edge": "a trailing newline"},
    {"typed": "2026-11-07T00:00", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-10-27", "edge": "a time after it"},
    {"typed": "٢٠٢٦-١١-٠٧", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "2026-10-27", "edge": "Arabic-Indic digits"},
    {"typed": "", "today": "", "day": 27, "endOfMonth": false, "expected": "", "edge": "no today either"},
    {"typed": "garbage", "today": "nonsense", "day": 27, "endOfMonth": false, "expected": "", "edge": "neither is a date"},
    {"typed": "", "today": "2026-02-30", "day": 27, "endOfMonth": false, "expected": "", "edge": "today is not a day either"},
    {"typed": "2026-11-07", "today": "2026-10-21", "day": 0, "endOfMonth": false, "expected": "", "edge": "day 0"},
    {"typed": "2026-11-07", "today": "2026-10-21", "day": 29, "endOfMonth": false, "expected": "", "edge": "day 29"},
    {"typed": "2026-11-07", "today": "2026-10-21", "day": -3, "endOfMonth": false, "expected": "", "edge": "a negative day"},
    {"typed": "2026-11-07", "today": "2026-10-21", "day": 99, "endOfMonth": true, "expected": "", "edge": "a day out of range, even at the end of the month"},
    {"typed": "0001-01-15", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "0001-01-27", "edge": "the first year is written with four digits"},
    {"typed": "9999-12-15", "today": "2026-10-21", "day": 28, "endOfMonth": true, "expected": "9999-12-31", "edge": "the last year, end of the month"},
    {"typed": "9999-12-20", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "9999-12-27", "edge": "the last year, before D"},
    {"typed": "9999-12-30", "today": "2026-10-21", "day": 27, "endOfMonth": false, "expected": "", "edge": "there is no year 10000"}
  ]
}
